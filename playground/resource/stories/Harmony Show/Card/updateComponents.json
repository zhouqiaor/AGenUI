          "height": "40px",
          "border-radius": "8px",
          "background-color": "#E8F3FF",
          "padding": "4px 12px"
        }
      },
      {
        "id": "card-action-text",
        "component": "Text",
        "text": "Action",
        "styles": {
          "font-size": "14px",
          "font-weight": "500",
          "color": "#007DFF",
          "text-align": "center"
        }
