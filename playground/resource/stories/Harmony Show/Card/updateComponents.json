        "align": "stretch",
        "styles": {
          "padding": "16px",
          "gap": "16px",
          "background-color": "#F5F6F7"
        }
      },
      {
        "id": "card-demo",
        "component": "Card",
        "child": "card-content",
        "styles": {
          "width": "auto",
          "height": "auto",
          "padding": "16px",
          "border-radius": "12px",
          "background-color": "#FFFFFF",
          "filter": "drop-shadow(0px 2px 12px 0px rgba(0, 0, 0, 0.06))"
        }
      },
      {
        "id": "card-content",
        "component": "Column",
        "children": ["card-title", "card-body", "card-action"],
        "align": "stretch"
      },
      {
        "id": "card-title",
        "component": "Text",
        "text": "Harmony Card",
        "styles": {
          "font-size": "18px",
          "font-weight": "500",
          "line-height": "24px",
          "color": "#181818",
          "text-align": "left"
        }
      },
      {
        "id": "card-body",
        "component": "Text",
        "text": "HarmonyOS design card with 12px radius, 16px padding, soft shadow, and surface_primary background.",
        "styles": {
          "font-size": "14px",
          "line-height": "20px",
          "color": "#666666",
          "text-align": "left"
        }
      },
      {
        "id": "card-action",
        "component": "Button",
        "child": "card-action-text",
        "styles": {
