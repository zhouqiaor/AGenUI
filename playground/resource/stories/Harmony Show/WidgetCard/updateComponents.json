{
  "version": "v0.9",
  "updateComponents": {
    "surfaceId": "harmony_widgetcard_demo",
    "components": [
      {
        "id": "root",
        "component": "Column",
        "children": ["widget-card", "widget-desc"],
        "align": "center",
        "styles": { "padding": "16px", "gap": "12px", "background-color": "#FFFFFF" }
      },
      {
        "id": "widget-card",
        "component": "Card",
        "child": "widget-content",
        "styles": {
          "width": "320px",
          "height": "200px",
          "border-radius": "16px",
          "background-color": "#FFFFFF",
          "padding": "16px",
          "filter": "drop-shadow(0px 2px 12px 0px rgba(0, 0, 0, 0.08))"
        }
      },
      {
        "id": "widget-content",
        "component": "Column",
        "children": ["wc-header", "wc-body"],
        "align": "stretch",
        "styles": { "gap": "12px" }
      },
      {
        "id": "wc-header",
        "component": "Row",
        "children": ["wc-icon", "wc-title"],
        "styles": { "gap": "8px", "align": "center" }
      },
      {
        "id": "wc-icon",
        "component": "Text",
        "text": "[]",
        "styles": { "font-size": "20px", "color": "#007DFF" }
      },
      {
        "id": "wc-title",
        "component": "Text",
        "text": "Weather Widget",
        "styles": { "font-size": "16px", "font-weight": "500", "color": "#181818", "text-align": "left" }
      },
      {
        "id": "wc-body",
        "component": "Row",
        "children": ["wc-temp", "wc-cond"],
        "styles": { "gap": "8px", "align": "center" }
      },
      {
        "id": "wc-temp",
        "component": "Text",
        "text": "26C",
        "styles": { "font-size": "30px", "font-weight": "500", "color": "#007DFF", "text-align": "left" }
      },
      {
        "id": "wc-cond",
        "component": "Text",
        "text": "Sunny",
        "styles": { "font-size": "14px", "color": "#666666", "text-align": "left" }
      },
      {
        "id": "widget-desc",
        "component": "Text",
        "text": "HarmonyOS WidgetCard: 16vp radius, card shadow, 250x120 minimum, responsive surface background.",
        "styles": { "font-size": "14px", "color": "#666666", "text-align": "center" }
      }
    ]
  }
}
