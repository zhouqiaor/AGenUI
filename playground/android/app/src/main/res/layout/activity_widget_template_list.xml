<?xml version="1.0" encoding="utf-8"?>
<!--
  Template list picker — HarmonyOS half-modal (Sheet) pattern.
  Right-side panel overlaying the screen, ~40% width on large screens.
  Uses a semi-transparent dim background + slide-in animation.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <!-- Right-side panel — 40% of screen width, full height -->
    <LinearLayout
        android:layout_width="40%"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/widget_bg"
        android:elevation="16dp">

        <!-- Header — HarmonyOS style: centered title + close button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:background="@color/widget_title_text">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_config_title"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnListClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close" />

        </LinearLayout>

        <!-- Template list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTemplateList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="8dp" />

    </LinearLayout>

</FrameLayout>
