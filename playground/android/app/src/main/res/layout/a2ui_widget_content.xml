<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/widget_title_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_refresh"
            android:src="@drawable/a2ui_widget_ic_refresh" />

        <ImageButton
            android:id="@+id/btnSwitchTemplate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_switch_template"
            android:src="@drawable/a2ui_widget_ic_template" />

        <ImageButton
            android:id="@+id/btnAiInput"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_ai_input"
            android:src="@drawable/a2ui_widget_ic_ai" />

        <TextView
            android:id="@+id/btnQuickJoin"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/a2ui_widget_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="入会"
            android:textColor="@color/widget_quick_join"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- A2UI rendered content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widgetImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_a2ui_content"
            android:scaleType="fitStart" />

        <!-- Loading state: shown while rendering -->
        <ProgressBar
            android:id="@+id/widgetLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Empty state: shown when no data available -->
        <TextView
            android:id="@+id/widgetEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_empty_state"
            android:textColor="@color/widget_empty_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Error state: shown when render fails -->
        <TextView
            android:id="@+id/widgetError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_error_state"
            android:textColor="@color/widget_error_text"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Template bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTemplateWeather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_template_weather"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/widget_template_weather"
            android:textColor="@color/widget_template_active"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnTemplateAgenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_template_agenda"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/widget_template_agenda"
            android:textColor="@color/widget_template_inactive"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnTemplateTodo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_template_todo"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/widget_template_todo"
            android:textColor="@color/widget_template_inactive"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnTemplateMeeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_template_meeting"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/widget_template_meeting"
            android:textColor="@color/widget_template_inactive"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnTemplatePoll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_template_poll"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/widget_template_poll"
            android:textColor="@color/widget_template_inactive"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnTemplateClassroom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_template_classroom"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/widget_template_classroom"
            android:textColor="@color/widget_template_inactive"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnTemplateFlashcard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_template_flashcard"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/widget_template_flashcard"
            android:textColor="@color/widget_template_inactive"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
