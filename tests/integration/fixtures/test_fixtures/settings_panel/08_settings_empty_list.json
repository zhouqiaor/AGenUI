{
  "messages": [
    {
      "type": "createSurface",
      "surfaceId": "settings-empty-list",
      "catalogId": "settings",
      "theme": {
        "colors": {
          "bg-primary": "#FFFFFF",
          "text-primary": "#1F1F22",
          "text-secondary": "#8A8A8E"
        }
      },
      "sendDataModel": false,
      "animated": false
    },
    {
      "type": "updateComponents",
      "surfaceId": "settings-empty-list",
      "components": [
        {
          "id": "root",
          "type": "Container",
          "properties": {
            "styles": {
              "width": "100%",
              "height": "100%",
              "backgroundColor": "#FFFFFF",
              "flexDirection": "column",
              "padding": "16px"
            }
          },
          "children": [
            {
              "id": "empty-list",
              "type": "List",
              "properties": {
                "styles": {
                  "width": "100%",
                  "height": "300px",
                  "direction": "vertical"
                },
                "itemTemplate": {
                  "type": "Text",
                  "properties": {
                    "text": "${data.label}"
                  }
                }
              }
            },
            {
              "id": "empty-hint",
              "type": "Text",
              "properties": {
                "text": "No items available",
                "styles": {
                  "color": "#8A8A8E",
                  "fontSize": "14px",
                  "textAlign": "center",
                  "marginTop": "20px"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "updateDataModel",
      "surfaceId": "settings-empty-list",
      "data": {
        "items": []
      }
    }
  ],
  "expect": {
    "componentCount": 3,
    "components": ["root", "empty-list", "empty-hint"]
  }
}
