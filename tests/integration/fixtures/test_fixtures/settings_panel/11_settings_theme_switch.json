{
  "messages": [
    {
      "type": "createSurface",
      "surfaceId": "settings-theme-switch",
      "catalogId": "settings",
      "theme": {
        "colors": {
          "bg-primary": "#FFFFFF",
          "text-primary": "#1F1F22",
          "accent": "#007AFF"
        }
      },
      "sendDataModel": false,
      "animated": false
    },
    {
      "type": "updateComponents",
      "surfaceId": "settings-theme-switch",
      "components": [
        {
          "id": "root",
          "type": "Container",
          "properties": {
            "styles": {
              "width": "100%",
              "height": "100%",
              "backgroundColor": "${theme.colors.bg-primary}",
              "flexDirection": "column",
              "padding": "16px"
            }
          },
          "children": [
            {
              "id": "title",
              "type": "Text",
              "properties": {
                "text": "Settings",
                "styles": {
                  "fontSize": "24px",
                  "fontWeight": "bold",
                  "color": "${theme.colors.text-primary}"
                }
              }
            },
            {
              "id": "dark-toggle",
              "type": "TequSettingsSwitch",
              "properties": {
                "label": "Dark Mode",
                "checked": false,
                "styles": {
                  "marginTop": "16px"
                }
              }
            },
            {
              "id": "accent-text",
              "type": "Text",
              "properties": {
                "text": "Accent color applied",
                "styles": {
                  "color": "${theme.colors.accent}",
                  "fontSize": "14px",
                  "marginTop": "8px"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "expect": {
    "componentCount": 4,
    "components": ["root", "title", "dark-toggle", "accent-text"]
  }
}
