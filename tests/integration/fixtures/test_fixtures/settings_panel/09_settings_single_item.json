{
  "messages": [
    {
      "type": "createSurface",
      "surfaceId": "settings-single-item",
      "catalogId": "settings",
      "theme": {
        "colors": {
          "bg-primary": "#FFFFFF",
          "text-primary": "#1F1F22"
        }
      },
      "sendDataModel": false,
      "animated": false
    },
    {
      "type": "updateComponents",
      "surfaceId": "settings-single-item",
      "components": [
        {
          "id": "root",
          "type": "Container",
          "properties": {
            "styles": {
              "width": "100%",
              "height": "100%",
              "backgroundColor": "#FFFFFF",
              "flexDirection": "column",
              "padding": "16px"
            }
          },
          "children": [
            {
              "id": "single-list",
              "type": "List",
              "properties": {
                "styles": {
                  "width": "100%",
                  "height": "wrap",
                  "direction": "vertical"
                },
                "itemTemplate": {
                  "type": "Text",
                  "properties": {
                    "text": "${data.label}",
                    "styles": {
                      "fontSize": "16px",
                      "color": "#1F1F22"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "updateDataModel",
      "surfaceId": "settings-single-item",
      "data": {
        "items": [
          { "label": "Only one item here" }
        ]
      }
    }
  ],
  "expect": {
    "componentCount": 2,
    "components": ["root", "single-list"]
  }
}
