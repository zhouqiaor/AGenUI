          {
            "id": "slider-item-control",
            "component": "Slider",
            "label": {"path": "title"},
            "min": 0,
            "max": {"path": "max"},
            "value": {"path": "value"},
            "styles": {"margin": "16px 0px 0px 72px"}
          }
        ]
